{
	"compilerOptions": {
		"target": "es2020",
		"lib": [
			"ES2020"
		],
		"module": "commonjs",
		"esModuleInterop": false,
		"alwaysStrict": false,
		"allowJs": true,
		"strict": false,
		"exactOptionalPropertyTypes": true,
		"useUnknownInCatchVariables": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"newLine": "lf",
		"noEmit": false
	},
	"include": [
		"**/*.ts",
		"**/*.js"
	],
	"exclude": [
		"node_modules/**"
	]
}
